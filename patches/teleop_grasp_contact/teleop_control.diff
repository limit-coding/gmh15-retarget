+# Grasp handling. A finger blocked by an object makes target-vs-measured error grow until the
+# check above disables the motors and the hand drops the object. When the fingertip tactile pad
+# reports contact, the closing target of that finger's joints is capped to a bounded lead over the
+# measured angle instead (bounded squeeze), so the free-space check never trips on a grasp.
+# Opening is never restricted. Without a contact signal the original behaviour is unchanged.
+JOINT_FINGER = {0: 'index', 2: 'middle', 4: 'ring', 6: 'pinky', 8: 'thumb', 9: 'thumb', 10: 'thumb'}
+CONTACT_DELTA_N = .5        # finger force above its arm-time baseline that counts as contact
+GRASP_LEAD_DEG = 6.         # in contact: closing target may lead the measured angle by at most this
+MAX_CONTACT_FORCE_N = 15.   # in contact above this (minus baseline): no further closing on that finger
 
 
