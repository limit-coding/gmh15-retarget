+def finger_forces(frame):
+    """Per-finger tactile force magnitude (N) from the acquisition frame; {} if unavailable."""
+    out = {}
+    for f in frame.get('fingers') or []:
+        v = f.get('force')
+        if isinstance(v, (list, tuple)) and len(v) == 3 and all(isinstance(x, (int, float)) and math.isfinite(x) for x in v):
+            out[f.get('key')] = math.sqrt(sum(float(x) * float(x) for x in v))
+    return out
+
